# Copy this file to ~/PokemonData/.env (or $POKEMON_DATA_DIR/.env) and fill
# in your keys. It lives outside the repo, so the keys never end up in it.
PULSEAPI_KEY=pk_live_your_api_key
# For publish.sh (uploading the pages to Cloudflare Pages):
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
# CF_PAGES_PROJECT=pokemon-missing-cards
